# API 路由和数据获取模式

本规则定义了 Dub 项目中 API 路由设计和数据获取的最佳实践。

## API 路由结构

### Next.js App Router API
API 路由位于 [apps/web/app/api/](mdc:apps/web/app/api/) 目录：

```
api/
├── auth/           # 认证相关 API
├── links/          # 链接管理
├── analytics/      # 分析数据
├── partners/       # 合作伙伴
├── customers/      # 客户管理
├── webhooks/       # Webhook 处理
└── workspaces/     # 工作区管理
```

### 路由文件命名
```typescript
// app/api/links/route.ts - 处理 /api/links
export async function GET() { ... }
export async function POST() { ... }

// app/api/links/[linkId]/route.ts - 处理 /api/links/:linkId
export async function GET(request: Request, { params }: { params: { linkId: string } }) { ... }

// app/api/links/[linkId]/analytics/route.ts - 嵌套路由
```

## API 路由实现模式

### 标准路由结构
```typescript
// app/api/example/route.ts
import { NextRequest } from "next/server";
import { getSession } from "@/lib/auth";
import { prisma } from "@dub/prisma";
import { z } from "zod";

// 1. 请求 Schema 定义
const createExampleSchema = z.object({
  name: z.string().min(1),
  description: z.string().optional(),
});

// 2. GET 处理函数
export async function GET(request: NextRequest) {
  try {
    // 认证检查
    const session = await getSession();
    if (!session?.user) {
      return new Response("Unauthorized", { status: 401 });
    }

    // 查询参数解析
    const { searchParams } = new URL(request.url);
    const page = parseInt(searchParams.get("page") || "1");
    const limit = parseInt(searchParams.get("limit") || "10");

    // 数据库查询
    const examples = await prisma.example.findMany({
      where: { userId: session.user.id },
      skip: (page - 1) * limit,
      take: limit,
    });

    return Response.json(examples);
  } catch (error) {
    console.error("GET /api/example error:", error);
    return new Response("Internal Server Error", { status: 500 });
  }
}

// 3. POST 处理函数
export async function POST(request: NextRequest) {
  try {
    const session = await getSession();
    if (!session?.user) {
      return new Response("Unauthorized", { status: 401 });
    }

    // 请求体验证
    const body = await request.json();
    const result = createExampleSchema.safeParse(body);
    
    if (!result.success) {
      return Response.json(
        { error: "Invalid request data", details: result.error.issues },
        { status: 400 }
      );
    }

    // 业务逻辑处理
    const example = await prisma.example.create({
      data: {
        ...result.data,
        userId: session.user.id,
      },
    });

    return Response.json(example, { status: 201 });
  } catch (error) {
    console.error("POST /api/example error:", error);
    return new Response("Internal Server Error", { status: 500 });
  }
}
```

### 动态路由参数
```typescript
// app/api/links/[linkId]/route.ts
export async function GET(
  request: NextRequest,
  { params }: { params: { linkId: string } }
) {
  const { linkId } = params;
  
  // 参数验证
  if (!linkId || typeof linkId !== "string") {
    return new Response("Invalid link ID", { status: 400 });
  }

  // 查询逻辑
  const link = await prisma.link.findUnique({
    where: { id: linkId },
  });

  if (!link) {
    return new Response("Link not found", { status: 404 });
  }

  return Response.json(link);
}
```

## 数据获取模式

### SWR Hooks
数据获取 hooks 位于 [apps/web/lib/swr/](mdc:apps/web/lib/swr/) 目录：

```typescript
// lib/swr/use-links.ts
import useSWR from "swr";
import { fetcher } from "@dub/utils";
import type { LinkProps } from "@/lib/types";

interface UseLinksParams {
  workspaceId?: string;
  page?: number;
  limit?: number;
}

export function useLinks({ workspaceId, page = 1, limit = 10 }: UseLinksParams = {}) {
  const { data, error, mutate } = useSWR<LinkProps[]>(
    workspaceId ? `/api/links?workspaceId=${workspaceId}&page=${page}&limit=${limit}` : null,
    fetcher,
    {
      revalidateOnFocus: false,
      dedupingInterval: 60000, // 1 minute
    }
  );

  return {
    links: data,
    loading: !error && !data,
    error,
    mutate,
  };
}
```

### API 客户端函数
客户端 API 函数位于 [apps/web/lib/api/](mdc:apps/web/lib/api/) 目录：

```typescript
// lib/api/links.ts
import { fetcher } from "@dub/utils";
import type { LinkProps, NewLinkProps } from "@/lib/types";

export const linksApi = {
  // 获取链接列表
  getLinks: async (params: {
    workspaceId: string;
    page?: number;
    limit?: number;
  }): Promise<LinkProps[]> => {
    const searchParams = new URLSearchParams({
      workspaceId: params.workspaceId,
      page: String(params.page || 1),
      limit: String(params.limit || 10),
    });
    
    return fetcher(`/api/links?${searchParams}`);
  },

  // 创建链接
  createLink: async (data: NewLinkProps): Promise<LinkProps> => {
    return fetcher("/api/links", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data),
    });
  },

  // 更新链接
  updateLink: async (linkId: string, data: Partial<LinkProps>): Promise<LinkProps> => {
    return fetcher(`/api/links/${linkId}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data),
    });
  },

  // 删除链接
  deleteLink: async (linkId: string): Promise<void> => {
    return fetcher(`/api/links/${linkId}`, {
      method: "DELETE",
    });
  },
};
```

## 认证和授权

### 会话检查
```typescript
// 在 API 路由中检查认证
import { getSession } from "@/lib/auth";

export async function GET(request: NextRequest) {
  const session = await getSession();
  
  if (!session?.user) {
    return new Response("Unauthorized", { status: 401 });
  }

  // 继续处理已认证的请求
}
```

### 权限检查
```typescript
// 检查工作区权限
import { getWorkspaceViaEdge } from "@/lib/planetscale";

export async function POST(request: NextRequest) {
  const session = await getSession();
  const { workspaceId } = await request.json();

  const workspace = await getWorkspaceViaEdge(workspaceId);
  
  if (!workspace || workspace.users.some(u => u.userId !== session.user.id)) {
    return new Response("Forbidden", { status: 403 });
  }

  // 继续处理
}
```

